/* JARVIS TUI Theme */

Screen {
    background: #0a0a0f;
    color: #e0e0e0;
}

/* Logo */
#logo {
    color: #00ffaa;
    text-style: bold;
    width: 10;
    margin: 1;
}

#tagline {
    color: #666;
    text-style: italic;
    margin: 1;
}

#setup-title {
    color: #00ffaa;
    text-style: bold;
    margin: 1;
    text-align: center;
}

#setup-subtitle {
    color: #aaa;
    margin: 1;
    text-align: center;
}

#setup-actions {
    margin: 1;
    height: 3;
}

#setup-footer {
    margin: 1;
    height: 1;
    dock: bottom;
}

/* Skills */
.skills-title {
    color: #00ffaa;
    text-style: bold;
    margin: 1;
}

.skill-name {
    color: #00ffaa;
    text-style: bold;
}

.skill-desc {
    color: #aaa;
}

.skill-count {
    color: #ffaa00;
}

/* Tool Cards */
.tool-name {
    color: #ffaa00;
}

.tool-desc {
    color: #888;
}

/* Skill Cards in Setup */
.skill-card-name {
    color: #00ffaa;
    text-style: bold;
}

.skill-card-desc {
    color: #aaa;
}

.skill-card-count {
    color: #ffaa00;
}

.skill-card {
    padding: 1 2;
    margin: 0 1;
    background: #111118;
    border: solid #333;
}

/* Section Labels */
.section-label {
    color: #00ffaa;
    text-style: bold;
    margin: 1 1 0 1;
}

/* Buttons */
Button {
    background: #1a1a2e;
    color: #e0e0e0;
    margin: 0 1;
}

Button:hover {
    background: #2a2a4e;
}

Button.primary {
    background: #00aa66;
    color: #fff;
}

Button.success {
    background: #00cc44;
    color: #fff;
}

/* Input */
Input {
    background: #111118;
    color: #e0e0e0;
    border: solid #333;
}

/* ListView */
ListView {
    background: #0d0d12;
    border: solid #333;
}

/* Status Bar */
#status-bar {
    background: #0a0a15;
    color: #666;
    dock: bottom;
    height: 1;
}

/* Tabbed Content */
TabPane {
    background: #0d0d12;
}

/* Header */
Header {
    background: #0a0a15;
    color: #00ffaa;
    height: 1;
}

/* Footer */
Footer {
    background: #0a0a15;
    color: #666;
    height: 1;
}

/* Chat Panel */
#chat-container {
    height: 1fr;
}

#input-container {
    height: 3;
    padding: 1;
}

#chat-input {
    width: 1fr;
    background: #111118;
    color: #e0e0e0;
}

#send-btn {
    background: #00aa66;
    color: #fff;
}
